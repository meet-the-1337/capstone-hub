datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FACULTY
  TEAM_LEAD
  TEAM_MEMBER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  role          Role           @default(TEAM_MEMBER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  teams         TeamMember[]
  ledTeams      Team[]         @relation("TeamLead")
  facultyReview Project[]      @relation("FacultyAdvisor")
  tasks         Task[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  facultyId   String?
  faculty     User?        @relation("FacultyAdvisor", fields: [facultyId], references: [id], onDelete: SetNull)
  teamId      String?      @unique
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  milestones   Milestone[]
  requirements Requirement[]
  userStories  UserStory[]
  sprints      Sprint[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("projects")
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

model Milestone {
  id          String          @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(UPCOMING)
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("milestones")
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model Requirement {
  id             String               @id @default(uuid())
  title          String
  description    String
  type           RequirementType      @default(FUNCTIONAL)
  priority       RequirementPriority  @default(MEDIUM)
  status         RequirementStatus    @default(DRAFT)
  reviewFeedback String?
  version        Int                  @default(1)
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       RequirementVersion[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("requirements")
}

model RequirementVersion {
  id             String              @id @default(uuid())
  versionNumber  Int
  title          String
  description    String
  type           RequirementType
  priority       RequirementPriority
  status         RequirementStatus
  reviewFeedback String?
  requirementId  String
  requirement    Requirement         @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@unique([requirementId, versionNumber])
  @@map("requirement_versions")
}

enum UserStoryPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UserStoryStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model UserStory {
  id          String            @id @default(uuid())
  title       String
  description String?
  status      UserStoryStatus   @default(TODO)
  priority    UserStoryPriority @default(MEDIUM)
  storyPoints Int?
  order       Int               @default(0)
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("user_stories")
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Sprint {
  id          String         @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus   @default(PLANNED)
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStories UserStory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("sprints")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  userStoryId String
  userStory   UserStory   @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("tasks")
}

model Team {
  id        String       @id @default(uuid())
  name      String
  leadId    String?
  lead      User?        @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  project   Project?
  members   TeamMember[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @default(TEAM_MEMBER)
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  details    String?
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  projectId  String?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
